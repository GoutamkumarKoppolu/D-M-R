{
  "name": "daivam-manushya-roopena",
  "private": true,
  "workspaces": [
    "packages/shared",
    "functions",
    "apps/mobile"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "emulators": "firebase emulators:start --config firebase/firebase.json",
    "emulators:test": "firebase emulators:exec --config firebase/firebase.json \"npm test\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "firebase-tools": "^14.25.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.47.0"
  }
}
